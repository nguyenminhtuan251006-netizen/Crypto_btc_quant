# ==============================================================================
# BINANCE CREDENTIALS CONFIGURATION TEMPLATE
# ==============================================================================

# Binance Mainnet / Real Account Credentials
BINANCE_API_KEY=your_mainnet_api_key_here
BINANCE_API_SECRET=your_mainnet_api_secret_here

# Binance Demo / Mock Trading Credentials
BINANCE_DEMO_API_KEY=your_binance_demo_api_key_here
BINANCE_DEMO_API_SECRET=your_binance_demo_api_secret_here

# Chế độ giao dịch: 'demo' (Mock trading) hoặc 'live' (Tài khoản thật)
BINANCE_MODE=demo
